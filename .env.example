# Environment
VITE_ENVIRONMENT_MODE=local


# Local: http://localhost:8000/api/v1
# Live:  https://api.sonographerpal.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Global protected routes (admin, etc.). `/account/*` is always login-required.
VITE_REQUIRE_AUTH=true

# Auth strategy: bearer_memory | http_only_cookie
VITE_AUTH_STRATEGY=bearer_memory

# Bearer token storage: session | local | memory
# session mirrors to localStorage so login works across browser tabs
VITE_BEARER_TOKEN_STORAGE=session

# Shomoshotime Laravel API (POST profile, DELETE logout)
VITE_AUTH_ME_PATH=/user/profile
VITE_AUTH_LOGOUT_PATH=/auth/logout

# Google Sign-In: OAuth 2.0 "Web application" Client ID (numeric prefix, e.g. 123456789-xxx.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=

# Practice quiz: click question image/PDF to open full-screen preview (default off)
VITE_PRACTICE_MEDIA_LIGHTBOX=false
